{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--browser",
        "chromium"
      ],
      "env": {
        "PLAYWRIGHT_MCP_HEADLESS": "1"
      },
      "disabled": false,
      "autoApprove": [
        "browser_navigate",
        "browser_snapshot",
        "browser_click",
        "browser_type",
        "browser_console_messages",
        "browser_network_requests",
        "browser_take_screenshot",
        "browser_evaluate",
        "browser_wait_for",
        "browser_hover",
        "browser_select_option",
        "browser_tab_list",
        "browser_tab_new",
        "browser_close"
      ]
    }
  }
}
